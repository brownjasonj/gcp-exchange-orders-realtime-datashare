FROM debian:bookworm AS sdk-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    git \
    build-essential \
    libssl-dev \
    zlib1g-dev \
    libcurl4-openssl-dev \
    libprotobuf-dev \
    protobuf-compiler \
    protobuf-compiler-grpc \
    libgrpc-dev \
    libgrpc++-dev \
    libc-ares-dev \
    libre2-dev \
    libboost-system-dev \
    libboost-date-time-dev \
    libboost-thread-dev \
    libasio-dev \
    nlohmann-json3-dev \
    pkg-config \
    ca-certificates \
    libabsl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build-sdk
RUN git clone --depth 1 --branch v2.24.0 https://github.com/googleapis/google-cloud-cpp.git

WORKDIR /build-sdk/google-cloud-cpp
RUN mkdir build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release \
          -DGOOGLE_CLOUD_CPP_ENABLE="bigquery;bigquery_storage" \
          -DGOOGLE_CLOUD_CPP_DEPENDENCY_PROVIDER=package \
          -DBUILD_TESTING=OFF \
          -DGOOGLE_CLOUD_CPP_ENABLE_EXAMPLES=OFF \
          .. && \
    make -j$(nproc) && \
    make install

# Final base image with everything installed in /usr/local
FROM debian:bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    git \
    build-essential \
    libssl-dev \
    zlib1g-dev \
    libcurl4-openssl-dev \
    libprotobuf-dev \
    protobuf-compiler \
    protobuf-compiler-grpc \
    libgrpc-dev \
    libgrpc++-dev \
    libc-ares-dev \
    libre2-dev \
    libboost-system-dev \
    libboost-date-time-dev \
    libboost-thread-dev \
    libasio-dev \
    nlohmann-json3-dev \
    pkg-config \
    ca-certificates \
    libabsl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=sdk-builder /usr/local /usr/local
RUN ldconfig
